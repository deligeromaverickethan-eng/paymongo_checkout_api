const express = require('express');
const cors = require('cors');
const axios = require('axios');
require('dotenv').config();

const app = express();

app.use(cors());
app.use(express.json());

// Validate environment variables
if (!process.env.PAYMONGO_SECRET_KEY) {
  console.error('❌ PAYMONGO_SECRET_KEY is not set in environment variables');
  process.exit(1);
}

// Verify key format
const secretKey = process.env.PAYMONGO_SECRET_KEY;
if (!secretKey.startsWith('sk_test_')) {
  console.warn('⚠️ WARNING: Secret key does not start with sk_test_');
  console.warn('   Make sure you are using a test key for this activity');
}

// POST /api/payment/checkout - Create a checkout session
app.post('/api/payment/checkout', async (req, res) => {
  try {
    const { orderId, items, customerEmail, successUrl, cancelUrl } = req.body;

    // Validate required fields
    if (!orderId) {
      return res.status(400).json({
        success: false,
        error: 'orderId is required'
      });
    }

    if (!items || !items.length) {
      return res.status(400).json({
        success: false,
        error: 'At least one item is required'
      });
    }

    // Format line items for PayMongo
    const lineItems = items.map(item => ({
      name: item.name || 'Unnamed Product',
      quantity: item.quantity || 1,
      amount: item.amount, // Already in centavos
      currency: 'PHP'
    }));

    // Prepare request to PayMongo
    const authString = Buffer.from(`${secretKey}:`).toString('base64');
    
    const payload = {
      data: {
        attributes: {
          line_items: lineItems,
          payment_method_types: ["card", "gcash", "paymaya"],
          success_url: successUrl || 'https://example.com/success',
          cancel_url: cancelUrl || 'https://example.com/cancel',
          billing: {
            email: customerEmail || 'customer@example.com'
          }
        }
      }
    };

    console.log(`📦 Creating checkout session for order ${orderId}`);
    console.log(`💰 Total items: ${lineItems.length}`);
    console.log(`💳 Total amount: ${lineItems.reduce((sum, item) => sum + (item.amount * item.quantity), 0)} centavos`);

    // Call PayMongo API
    const response = await axios.post(
      'https://api.paymongo.com/v1/checkout_sessions',
      payload,
      {
        headers: {
          'Authorization': `Basic ${authString}`,
          'Content-Type': 'application/json'
        }
      }
    );

    // Extract checkout URL from response
    const checkoutSession = response.data.data;
    const checkoutUrl = checkoutSession.attributes.checkout_url;
    const sessionId = checkoutSession.id;

    console.log(`✅ Checkout session created successfully`);
    console.log(`🔗 Session ID: ${sessionId}`);
    console.log(`🌐 Checkout URL: ${checkoutUrl}`);

    res.json({
      success: true,
      sessionId: sessionId,
      checkoutUrl: checkoutUrl,
      orderId: orderId
    });

  } catch (error) {
    console.error('❌ PayMongo API error:');
    
    if (error.response) {
      // The request was made and the server responded with a status code
      // outside of 2xx
      console.error('Status:', error.response.status);
      console.error('Data:', JSON.stringify(error.response.data, null, 2));
      
      return res.status(error.response.status || 500).json({
        success: false,
        error: 'Payment gateway error',
        details: error.response.data
      });
    } else if (error.request) {
      // The request was made but no response was received
      console.error('No response received from PayMongo');
      return res.status(503).json({
        success: false,
        error: 'Payment gateway timeout',
        details: 'No response received from PayMongo'
      });
    } else {
      // Something happened in setting up the request
      console.error('Error:', error.message);
      return res.status(500).json({
        success: false,
        error: 'Internal payment service error',
        details: error.message
      });
    }
  }
});

// GET /api/payment/health - Health check endpoint
app.get('/api/payment/health', (req, res) => {
  res.json({
    status: 'healthy',
    environment: process.env.NODE_ENV || 'development',
    hasSecretKey: !!process.env.PAYMONGO_SECRET_KEY
  });
});

const PORT = process.env.PORT || 3003;
app.listen(PORT, () => {
  console.log('='.repeat(50));
  console.log('💰 Payment Service');
  console.log('='.repeat(50));
  console.log(`✅ Running on port ${PORT}`);
  console.log(`🔑 Secret Key present: ${process.env.PAYMONGO_SECRET_KEY ? 'Yes' : 'No'}`);
  console.log(`🔐 Key type: ${process.env.PAYMONGO_SECRET_KEY?.startsWith('sk_test_') ? 'Test Key ✅' : '⚠️ Not a test key'}`);
  console.log('='.repeat(50));
});
